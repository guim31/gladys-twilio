{
  "manifest_version": 1,
  "type": "device",
  "name": "Twilio",
  "description": {
    "en": "SMS and voice calls from your Gladys scenes through your Twilio account, with a cost guard.",
    "fr": "SMS et appels vocaux depuis vos scènes Gladys via votre compte Twilio, avec un garde-fou de coût.",
    "de": "SMS und Sprachanrufe aus deinen Gladys-Szenen über dein Twilio-Konto, mit Kostenschutz.",
    "es": "SMS y llamadas de voz desde sus escenas de Gladys con su cuenta Twilio, con control de gastos."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/guim31/gladys-twilio:1.0.0",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-twilio/main/cover.png",
  "categories": ["notifications"],
  "transports": ["cloud"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Your Twilio account",
        "fr": "Votre compte Twilio",
        "de": "Dein Twilio-Konto",
        "es": "Su cuenta Twilio"
      },
      "description": {
        "en": "Twilio bills every SMS and every call to your account: set the cost guard below. The Account SID is on the home page of the Twilio console; an API key is safer than the Auth Token.",
        "fr": "Twilio facture chaque SMS et chaque appel sur votre compte : réglez le garde-fou ci-dessous. L’Account SID est sur l’accueil de la console Twilio ; une clé d’API est plus sûre que l’Auth Token.",
        "de": "Twilio berechnet jede SMS und jeden Anruf deinem Konto: Stell unten den Kostenschutz ein. Die Account SID steht auf der Startseite der Twilio-Konsole; ein API-Schlüssel ist sicherer als das Auth Token.",
        "es": "Twilio factura cada SMS y cada llamada a su cuenta: ajuste el control de gastos más abajo. El Account SID está en la página de inicio de la consola de Twilio; una clave de API es más segura que el Auth Token."
      },
      "links": [
        {
          "url": "https://console.twilio.com/",
          "label": {
            "en": "Twilio console",
            "fr": "Console Twilio",
            "de": "Twilio-Konsole",
            "es": "Consola de Twilio"
          }
        },
        {
          "url": "https://www.twilio.com/docs/iam/api-keys",
          "label": {
            "en": "Create an API key",
            "fr": "Créer une clé d’API",
            "de": "API-Schlüssel erstellen",
            "es": "Crear una clave de API"
          }
        }
      ]
    },
    {
      "key": "account_sid",
      "type": "string",
      "label": {
        "en": "Account SID",
        "fr": "Account SID",
        "de": "Account SID",
        "es": "Account SID"
      },
      "description": {
        "en": "Starts with AC, then 32 characters.",
        "fr": "Commence par AC, puis 32 caractères.",
        "de": "Beginnt mit AC, dann 32 Zeichen.",
        "es": "Empieza por AC y sigue con 32 caracteres."
      },
      "placeholder": {
        "en": "AC…",
        "fr": "AC…",
        "de": "AC…",
        "es": "AC…"
      },
      "required": true,
      "default": ""
    },
    {
      "key": "api_key_sid",
      "type": "string",
      "label": {
        "en": "API key SID (recommended)",
        "fr": "SID de la clé d’API (conseillé)",
        "de": "SID des API-Schlüssels (empfohlen)",
        "es": "SID de la clave de API (recomendado)"
      },
      "description": {
        "en": "A Standard API key, starting with SK. Leave empty to use the Auth Token.",
        "fr": "Une clé d’API Standard, qui commence par SK. Vide pour utiliser l’Auth Token.",
        "de": "Ein Standard-API-Schlüssel, beginnt mit SK. Leer lassen, um das Auth Token zu verwenden.",
        "es": "Una clave de API Standard, que empieza por SK. Déjelo vacío para usar el Auth Token."
      },
      "placeholder": {
        "en": "SK…",
        "fr": "SK…",
        "de": "SK…",
        "es": "SK…"
      },
      "required": false,
      "default": ""
    },
    {
      "key": "api_key_secret",
      "type": "secret",
      "label": {
        "en": "API key secret",
        "fr": "Secret de la clé d’API",
        "de": "Secret des API-Schlüssels",
        "es": "Secreto de la clave de API"
      },
      "description": {
        "en": "Shown once by Twilio when the key is created.",
        "fr": "Affiché une seule fois par Twilio à la création de la clé.",
        "de": "Wird von Twilio nur einmal beim Erstellen des Schlüssels angezeigt.",
        "es": "Twilio lo muestra una sola vez al crear la clave."
      },
      "required": false
    },
    {
      "key": "auth_token",
      "type": "secret",
      "label": {
        "en": "Auth Token",
        "fr": "Auth Token",
        "de": "Auth Token",
        "es": "Auth Token"
      },
      "description": {
        "en": "Only without an API key. It gives full access to the account.",
        "fr": "Seulement sans clé d’API. Il donne un accès complet au compte.",
        "de": "Nur ohne API-Schlüssel. Es gibt vollen Zugriff auf das Konto.",
        "es": "Solo sin clave de API. Da acceso completo a la cuenta."
      },
      "required": false
    },
    {
      "key": "from_number",
      "type": "string",
      "label": {
        "en": "Sender",
        "fr": "Expéditeur",
        "de": "Absender",
        "es": "Remitente"
      },
      "description": {
        "en": "Your Twilio number in international format. A sender name or a Messaging Service SID (MG…) works for SMS only.",
        "fr": "Votre numéro Twilio au format international. Un nom d’expéditeur ou un Messaging Service (MG…) ne sert qu’aux SMS.",
        "de": "Deine Twilio-Nummer im internationalen Format. Ein Absendername oder ein Messaging Service (MG…) gilt nur für SMS.",
        "es": "Su número Twilio en formato internacional. Un nombre de remitente o un Messaging Service (MG…) solo sirve para SMS."
      },
      "placeholder": {
        "en": "e.g. +33612345678",
        "fr": "ex. +33612345678",
        "de": "z. B. +33612345678",
        "es": "p. ej. +33612345678"
      },
      "required": true,
      "default": ""
    },
    {
      "key": "default_recipients",
      "type": "string",
      "label": {
        "en": "Default recipients",
        "fr": "Destinataires par défaut",
        "de": "Standardempfänger",
        "es": "Destinatarios por defecto"
      },
      "description": {
        "en": "International numbers separated by commas, the most important first. Used when an action names none.",
        "fr": "Numéros internationaux séparés par des virgules, le plus important en premier. Utilisés quand une action n’en donne pas.",
        "de": "Internationale Nummern, durch Kommas getrennt, die wichtigste zuerst. Gelten, wenn eine Aktion keine nennt.",
        "es": "Números internacionales separados por comas, el más importante primero. Se usan cuando una acción no indica ninguno."
      },
      "placeholder": {
        "en": "+33612345678, +33698765432",
        "fr": "+33612345678, +33698765432",
        "de": "+4915112345678, +4917612345678",
        "es": "+34612345678, +34698765432"
      },
      "required": false,
      "default": ""
    },
    {
      "key": "guard",
      "type": "section",
      "label": {
        "en": "Cost guard",
        "fr": "Garde-fou de coût",
        "de": "Kostenschutz",
        "es": "Control de gastos"
      },
      "description": {
        "en": "Past these limits nothing is sent until the window frees up: a scene that loops cannot empty your account. Each recipient counts as one SMS. 0 blocks.",
        "fr": "Au-delà de ces plafonds, rien n’est envoyé jusqu’à ce que la fenêtre se libère : une scène qui boucle ne peut pas vider votre compte. Chaque destinataire compte pour un SMS. 0 bloque.",
        "de": "Über diesen Grenzen wird nichts gesendet, bis das Zeitfenster wieder frei ist: Eine Szene in einer Schleife kann dein Konto nicht leeren. Jeder Empfänger zählt als eine SMS. 0 sperrt.",
        "es": "Por encima de estos límites no se envía nada hasta que se libere la ventana: una escena en bucle no puede vaciar su cuenta. Cada destinatario cuenta como un SMS. 0 bloquea."
      }
    },
    {
      "key": "max_sms_per_hour",
      "type": "number",
      "label": {
        "en": "Most SMS per hour",
        "fr": "SMS par heure, au plus",
        "de": "Höchstens SMS pro Stunde",
        "es": "Máximo de SMS por hora"
      },
      "required": false,
      "default": 10,
      "min": 0,
      "max": 500
    },
    {
      "key": "max_sms_per_day",
      "type": "number",
      "label": {
        "en": "Most SMS per day",
        "fr": "SMS par jour, au plus",
        "de": "Höchstens SMS pro Tag",
        "es": "Máximo de SMS por día"
      },
      "required": false,
      "default": 30,
      "min": 0,
      "max": 2000
    },
    {
      "key": "max_calls_per_hour",
      "type": "number",
      "label": {
        "en": "Most calls per hour",
        "fr": "Appels par heure, au plus",
        "de": "Höchstens Anrufe pro Stunde",
        "es": "Máximo de llamadas por hora"
      },
      "required": false,
      "default": 5,
      "min": 0,
      "max": 100
    },
    {
      "key": "max_calls_per_day",
      "type": "number",
      "label": {
        "en": "Most calls per day",
        "fr": "Appels par jour, au plus",
        "de": "Höchstens Anrufe pro Tag",
        "es": "Máximo de llamadas por día"
      },
      "required": false,
      "default": 10,
      "min": 0,
      "max": 500
    },
    {
      "key": "calls",
      "type": "section",
      "label": {
        "en": "Calls and texts",
        "fr": "Appels et textes",
        "de": "Anrufe und Texte",
        "es": "Llamadas y textos"
      },
      "description": {
        "en": "A call reads the message out with a text-to-speech voice, in the language chosen in the action or below.",
        "fr": "Un appel lit le message avec une voix de synthèse, dans la langue choisie dans l’action ou ci-dessous.",
        "de": "Ein Anruf liest die Nachricht mit einer Sprachausgabe vor, in der Sprache der Aktion oder der unten gewählten.",
        "es": "Una llamada lee el mensaje con una voz sintética, en el idioma elegido en la acción o más abajo."
      }
    },
    {
      "key": "voice",
      "type": "select",
      "label": {
        "en": "Voice",
        "fr": "Voix",
        "de": "Stimme",
        "es": "Voz"
      },
      "required": false,
      "default": "female",
      "options": [
        {
          "value": "female",
          "label": {
            "en": "Female",
            "fr": "Féminine",
            "de": "Weiblich",
            "es": "Femenina"
          }
        },
        {
          "value": "male",
          "label": {
            "en": "Male",
            "fr": "Masculine",
            "de": "Männlich",
            "es": "Masculina"
          }
        }
      ]
    },
    {
      "key": "ring_seconds",
      "type": "select",
      "label": {
        "en": "Ring time",
        "fr": "Durée de sonnerie",
        "de": "Klingeldauer",
        "es": "Tiempo de llamada"
      },
      "description": {
        "en": "Hang up sooner to avoid the voicemail, which counts as answered.",
        "fr": "Raccrocher plus tôt évite la messagerie, qui compte comme une réponse.",
        "de": "Früher auflegen vermeidet die Mailbox, die als Antwort zählt.",
        "es": "Colgar antes evita el buzón de voz, que cuenta como respuesta."
      },
      "required": false,
      "default": "30",
      "options": [
        {
          "value": "15",
          "label": {
            "en": "15 s",
            "fr": "15 s",
            "de": "15 s",
            "es": "15 s"
          }
        },
        {
          "value": "20",
          "label": {
            "en": "20 s",
            "fr": "20 s",
            "de": "20 s",
            "es": "20 s"
          }
        },
        {
          "value": "30",
          "label": {
            "en": "30 s",
            "fr": "30 s",
            "de": "30 s",
            "es": "30 s"
          }
        },
        {
          "value": "45",
          "label": {
            "en": "45 s",
            "fr": "45 s",
            "de": "45 s",
            "es": "45 s"
          }
        },
        {
          "value": "60",
          "label": {
            "en": "60 s",
            "fr": "60 s",
            "de": "60 s",
            "es": "60 s"
          }
        }
      ]
    },
    {
      "key": "language",
      "type": "select",
      "label": {
        "en": "Language",
        "fr": "Langue",
        "de": "Sprache",
        "es": "Idioma"
      },
      "description": {
        "en": "Of the calls, the test SMS, the device names and the failure texts.",
        "fr": "Des appels, du SMS de test, des noms de l’appareil et des textes d’échec.",
        "de": "Der Anrufe, der Test-SMS, der Gerätenamen und der Fehlertexte.",
        "es": "De las llamadas, del SMS de prueba, de los nombres del dispositivo y de los textos de fallo."
      },
      "required": false,
      "default": "fr",
      "options": [
        {
          "value": "en",
          "label": {
            "en": "English",
            "fr": "Anglais",
            "de": "Englisch",
            "es": "Inglés"
          }
        },
        {
          "value": "fr",
          "label": {
            "en": "French",
            "fr": "Français",
            "de": "Französisch",
            "es": "Francés"
          }
        },
        {
          "value": "de",
          "label": {
            "en": "German",
            "fr": "Allemand",
            "de": "Deutsch",
            "es": "Alemán"
          }
        },
        {
          "value": "es",
          "label": {
            "en": "Spanish",
            "fr": "Espagnol",
            "de": "Spanisch",
            "es": "Español"
          }
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "test_connection",
      "label": {
        "en": "Test the connection",
        "fr": "Tester la connexion",
        "de": "Verbindung testen",
        "es": "Probar la conexión"
      },
      "timeout_seconds": 30
    },
    {
      "key": "send_test_sms",
      "label": {
        "en": "Send a test SMS",
        "fr": "Envoyer un SMS de test",
        "de": "Test-SMS senden",
        "es": "Enviar un SMS de prueba"
      },
      "timeout_seconds": 60,
      "fields": [
        {
          "key": "to",
          "type": "string",
          "label": {
            "en": "Recipient (empty: the default ones)",
            "fr": "Destinataire (vide : ceux par défaut)",
            "de": "Empfänger (leer: die Standardempfänger)",
            "es": "Destinatario (vacío: los de por defecto)"
          },
          "placeholder": {
            "en": "e.g. +33612345678",
            "fr": "ex. +33612345678",
            "de": "z. B. +33612345678",
            "es": "p. ej. +33612345678"
          }
        }
      ]
    }
  ],
  "scene_triggers": [
    {
      "key": "send_failed",
      "label": {
        "en": "SMS or call failed",
        "fr": "SMS ou appel en échec",
        "de": "SMS oder Anruf fehlgeschlagen",
        "es": "SMS o llamada fallida"
      },
      "description": {
        "en": "An SMS or a call did not reach its recipient: refused, not delivered, not answered.",
        "fr": "Un SMS ou un appel n’a pas atteint son destinataire : refusé, non distribué, sans réponse.",
        "de": "Eine SMS oder ein Anruf hat den Empfänger nicht erreicht: abgelehnt, nicht zugestellt, keine Antwort.",
        "es": "Un SMS o una llamada no llegó a su destinatario: rechazado, no entregado, sin respuesta."
      },
      "fields": [
        {
          "key": "kind",
          "type": "select",
          "label": {
            "en": "SMS or call",
            "fr": "SMS ou appel",
            "de": "SMS oder Anruf",
            "es": "SMS o llamada"
          },
          "options": [
            {
              "value": "sms",
              "label": {
                "en": "SMS",
                "fr": "SMS",
                "de": "SMS",
                "es": "SMS"
              }
            },
            {
              "value": "call",
              "label": {
                "en": "Call",
                "fr": "Appel",
                "de": "Anruf",
                "es": "Llamada"
              }
            }
          ]
        },
        {
          "key": "status",
          "type": "multi_select",
          "label": {
            "en": "Outcome",
            "fr": "Résultat",
            "de": "Ergebnis",
            "es": "Resultado"
          },
          "options": [
            {
              "value": "refused",
              "label": {
                "en": "Refused by Twilio",
                "fr": "Refusé par Twilio",
                "de": "Von Twilio abgelehnt",
                "es": "Rechazado por Twilio"
              }
            },
            {
              "value": "failed",
              "label": {
                "en": "Failed",
                "fr": "Échoué",
                "de": "Fehlgeschlagen",
                "es": "Fallido"
              }
            },
            {
              "value": "undelivered",
              "label": {
                "en": "SMS not delivered",
                "fr": "SMS non distribué",
                "de": "SMS nicht zugestellt",
                "es": "SMS no entregado"
              }
            },
            {
              "value": "no-answer",
              "label": {
                "en": "No answer",
                "fr": "Pas de réponse",
                "de": "Keine Antwort",
                "es": "Sin respuesta"
              }
            },
            {
              "value": "busy",
              "label": {
                "en": "Line busy",
                "fr": "Ligne occupée",
                "de": "Leitung besetzt",
                "es": "Línea ocupada"
              }
            },
            {
              "value": "canceled",
              "label": {
                "en": "Canceled",
                "fr": "Annulé",
                "de": "Abgebrochen",
                "es": "Cancelado"
              }
            }
          ]
        },
        {
          "key": "recipient",
          "type": "string",
          "label": {
            "en": "Recipient (optional)",
            "fr": "Destinataire (facultatif)",
            "de": "Empfänger (optional)",
            "es": "Destinatario (opcional)"
          },
          "description": {
            "en": "The number in international format, as in the action.",
            "fr": "Le numéro au format international, comme dans l’action.",
            "de": "Die Nummer im internationalen Format, wie in der Aktion.",
            "es": "El número en formato internacional, como en la acción."
          },
          "placeholder": {
            "en": "e.g. +33612345678",
            "fr": "ex. +33612345678",
            "de": "z. B. +33612345678",
            "es": "p. ej. +33612345678"
          }
        }
      ],
      "variables": [
        {
          "key": "kind",
          "type": "string",
          "label": {
            "en": "SMS or call",
            "fr": "SMS ou appel",
            "de": "SMS oder Anruf",
            "es": "SMS o llamada"
          }
        },
        {
          "key": "recipient",
          "type": "string",
          "label": {
            "en": "Recipient",
            "fr": "Destinataire",
            "de": "Empfänger",
            "es": "Destinatario"
          }
        },
        {
          "key": "status",
          "type": "string",
          "label": {
            "en": "Outcome",
            "fr": "Résultat",
            "de": "Ergebnis",
            "es": "Resultado"
          }
        },
        {
          "key": "reason",
          "type": "string",
          "label": {
            "en": "Reason",
            "fr": "Raison",
            "de": "Grund",
            "es": "Motivo"
          }
        },
        {
          "key": "error_code",
          "type": "number",
          "label": {
            "en": "Twilio error code",
            "fr": "Code d’erreur Twilio",
            "de": "Twilio-Fehlercode",
            "es": "Código de error de Twilio"
          }
        }
      ]
    },
    {
      "key": "limit_reached",
      "label": {
        "en": "Cost guard limit reached",
        "fr": "Plafond du garde-fou atteint",
        "de": "Limit des Kostenschutzes erreicht",
        "es": "Límite del control de gastos alcanzado"
      },
      "description": {
        "en": "SMS or calls were held back by the limits of the configuration. Once per episode.",
        "fr": "Des SMS ou appels ont été retenus par les plafonds de la configuration. Une fois par épisode.",
        "de": "SMS oder Anrufe wurden von den Grenzen der Konfiguration zurückgehalten. Einmal pro Vorfall.",
        "es": "Se retuvieron SMS o llamadas por los límites de la configuración. Una vez por episodio."
      },
      "fields": [
        {
          "key": "kind",
          "type": "select",
          "label": {
            "en": "SMS or call",
            "fr": "SMS ou appel",
            "de": "SMS oder Anruf",
            "es": "SMS o llamada"
          },
          "options": [
            {
              "value": "sms",
              "label": {
                "en": "SMS",
                "fr": "SMS",
                "de": "SMS",
                "es": "SMS"
              }
            },
            {
              "value": "call",
              "label": {
                "en": "Call",
                "fr": "Appel",
                "de": "Anruf",
                "es": "Llamada"
              }
            }
          ]
        },
        {
          "key": "window",
          "type": "select",
          "label": {
            "en": "Limit",
            "fr": "Plafond",
            "de": "Limit",
            "es": "Límite"
          },
          "options": [
            {
              "value": "hour",
              "label": {
                "en": "Per hour",
                "fr": "Par heure",
                "de": "Pro Stunde",
                "es": "Por hora"
              }
            },
            {
              "value": "day",
              "label": {
                "en": "Per day",
                "fr": "Par jour",
                "de": "Pro Tag",
                "es": "Por día"
              }
            }
          ]
        }
      ],
      "variables": [
        {
          "key": "kind",
          "type": "string",
          "label": {
            "en": "SMS or call",
            "fr": "SMS ou appel",
            "de": "SMS oder Anruf",
            "es": "SMS o llamada"
          }
        },
        {
          "key": "window",
          "type": "string",
          "label": {
            "en": "Limit (hour or day)",
            "fr": "Plafond (heure ou jour)",
            "de": "Limit (Stunde oder Tag)",
            "es": "Límite (hora o día)"
          }
        },
        {
          "key": "limit",
          "type": "number",
          "label": {
            "en": "Limit value",
